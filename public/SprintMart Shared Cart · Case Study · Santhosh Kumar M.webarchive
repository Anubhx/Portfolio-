8Õ	_0https://www.designbysanthosh.in/site.webmanifestOn{
  "name": "Santhosh Kumar M",
  "short_name": "designbysanthosh",
  "description": "Brand and marketing design portfolio. Bengaluru, India.",
  "start_url": "/",
  "display": "browser",
  "background_color": "#0C0C0B",
  "theme_color": "#0C0C0B",
  "icons": [
    {
      "src": "assets/img/favicon-32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
