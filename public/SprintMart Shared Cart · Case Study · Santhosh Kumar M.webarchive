^WebResourceURL_WebResourceTextEncodingName_WebResourceData_WebResourceMIMEType_WebResourceResponse_0https://www.designbysanthosh.in/assets/js/app.jsUutf-8OHë/* â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
   SHARED APP JS Â· runs on every page
â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â” */

(() => {
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* â”€â”€â”€ Smooth Scroll & Parallax (Lenis) â”€â”€â”€ */
  if (typeof Lenis !== 'undefined') {
    const lenis = new Lenis({
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      orientation: 'vertical',
      gestureOrientation: 'vertical',
      smoothWheel: true,
      wheelMultiplier: 1,
      smoothTouch: false,
      touchMultiplier: 2,
      infinite: false,
    });

    const getAbsoluteY = (el) => {
      let y = 0;
      while(el) { y += el.offsetTop; el = el.offsetParent; }
      return y;
    };

    const pElements = prefersReduced ? [] : Array.from(document.querySelectorAll('[data-parallax]')).map(el => {
      // Force hardware acceleration upfront
      el.style.willChange = 'transform';
      return {
        el,
        speed: parseFloat(el.getAttribute('data-parallax')) || 0,
        absY: getAbsoluteY(el),
        height: el.offsetHeight || 500
      };
    });

    /* Scroll-presence elements: progress through viewport mapped to --cta-p */
    const zElements = prefersReduced ? [] : Array.from(document.querySelectorAll('[data-zoom]')).map(el => ({
      el,
      absY: getAbsoluteY(el)
    }));

    /* Marquee: velocity-linked drive. CSS keyframes remain the no-JS fallback. */
    const mTracks = prefersReduced ? [] : Array.from(document.querySelectorAll('.marquee__track')).map(track => {
      track.style.animation = 'none';
      track.style.willChange = 'transform';
      const m = { track, x: 0, half: track.scrollWidth / 2, mult: 1, skew: 0, hover: false, visible: true };
      const host = track.closest('.marquee');
      if (host) {
        host.addEventListener('mouseenter', () => { m.hover = true; });
        host.addEventListener('mouseleave', () => { m.hover = false; });
        // Only drive the track while it's actually on screen. Saves the compositor
        // from transforming off-screen marquees every frame.
        if ('IntersectionObserver' in window) {
          new IntersectionObserver((es) => { es.forEach((e) => { m.visible = e.isIntersecting; }); },
            { rootMargin: '120px 0px' }).observe(host);
        }
      }
      return m;
    });
    window.addEventListener('resize', () => {
      mTracks.forEach(m => { m.half = m.track.scrollWidth / 2; });
    }, { passive: true });

    let mVel = 0;

    lenis.on('scroll', (e) => {
      const scrollY = e.animatedScroll || window.scrollY;
      const vh = window.innerHeight;
      mVel = e.velocity || 0;

      for(let i=0; i < pElements.length; i++) {
        const item = pElements[i];
        const rectTop = item.absY - scrollY;

        // Basic viewport culling for performance
        if (rectTop < vh + 200 && rectTop + item.height > -200) {
           const offset = (rectTop - vh / 2) * item.speed;
           item.el.style.transform = `translate3d(0, ${offset}px, 0)`;
        }
      }

      for (let i = 0; i < zElements.length; i++) {
        const z = zElements[i];
        const rectTop = z.absY - scrollY;
        let p = (vh - rectTop) / (vh * 0.85);
        p = Math.max(0, Math.min(1, p));
        p = 1 - Math.pow(1 - p, 3); // ease-out, settles as it arrives
        z.el.style.setProperty('--cta-p', p.toFixed(4));
      }
    });

    const marqueeTick = () => {
      for (let i = 0; i < mTracks.length; i++) {
        const m = mTracks[i];
        if (!m.visible) continue;   // don't tick off-screen marquees
        m.mult += ((m.hover ? 0 : 1) - m.mult) * 0.08;
        const boost = Math.min(Math.abs(mVel) * 0.22, 2.6);
        m.x -= (m.half / 2280 + boost) * m.mult;   // base speed matches the 38s CSS loop
        if (m.x <= -m.half) m.x += m.half;
        const skewT = Math.max(-4, Math.min(4, mVel * -0.35));
        m.skew += (skewT - m.skew) * 0.12;
        m.track.style.transform = `translate3d(${m.x}px, 0, 0) skewX(${m.skew.toFixed(3)}deg)`;
      }
      mVel *= 0.94; // decay once scrolling stops
    };

    function raf(time) {
      lenis.raf(time);
      marqueeTick();
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);
    window.lenis = lenis; // Expose globally just in case
  }

  /* â”€â”€â”€ Theme toggle (persisted) â”€â”€â”€ */
  const root = document.documentElement;
  const savedTheme = localStorage.getItem('sk:theme');
  if (savedTheme) root.setAttribute('data-theme', savedTheme);

  window.toggleTheme = () => {
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    if (next === 'dark') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', 'light');
    localStorage.setItem('sk:theme', next);
  };

  /* â”€â”€â”€ Nav scroll state â”€â”€â”€ */
  const nav = document.getElementById('nav');
  if (nav) {
    let ticking = false;
    const apply = () => {
      const threshold = nav.classList.contains('nav--hero')
        ? Math.max(80, window.innerHeight * 0.65)
        : 40;
      nav.classList.toggle('is-scrolled', window.scrollY > threshold);
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { requestAnimationFrame(apply); ticking = true; }
    }, { passive: true });
    apply();
  }

  /* â”€â”€â”€ Mobile menu â”€â”€â”€ */
  const ham = document.getElementById('navHam');
  const menu = document.getElementById('mobMenu');
  if (ham && menu) {
    const toggle = (state) => {
      const open = state ?? !menu.classList.contains('is-open');
      menu.classList.toggle('is-open', open);
      ham.classList.toggle('is-open', open);
      ham.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    };
    ham.addEventListener('click', () => toggle());
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => toggle(false)));
  }

  /* â”€â”€â”€ Reveal on view â”€â”€â”€ */
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.reveal, .split, .reveal-stagger, .reveal-mask').forEach((el) => io.observe(el));

  /* â”€â”€â”€ Split text: wrap each word in a span â”€â”€â”€ */
  document.querySelectorAll('[data-split]').forEach((el) => {
    const text = el.textContent.trim();
    el.innerHTML = '';
    el.classList.add('split');
    text.split(/(\s+)/).forEach((chunk) => {
      if (/^\s+$/.test(chunk)) {
        el.appendChild(document.createTextNode(' '));
      } else if (chunk) {
        const w = document.createElement('span');
        w.className = 'word';
        const inner = document.createElement('span');
        inner.textContent = chunk;
        w.appendChild(inner);
        el.appendChild(w);
      }
    });
    io.observe(el);
  });

  /* â”€â”€â”€ Custom cursor â”€â”€â”€ */
  const isCoarse = window.matchMedia('(hover: none)').matches;
  if (!isCoarse && window.innerWidth > 720) {
    const cur = document.createElement('div');
    cur.className = 'cursor';
    cur.innerHTML = '<span class="cursor__label"></span>';
    document.body.appendChild(cur);
    const label = cur.querySelector('.cursor__label');

    let tx = 0, ty = 0, cx = 0, cy = 0;
    window.addEventListener('mousemove', (e) => {
      tx = e.clientX; ty = e.clientY;
      if (!cur.classList.contains('is-ready')) cur.classList.add('is-ready');
    });
    const tick = () => {
      cx += (tx - cx) * 0.22;
      cy += (ty - cy) * 0.22;
      cur.style.transform = `translate(${cx}px, ${cy}px) translate(-50%, -50%)`;
      requestAnimationFrame(tick);
    };
    tick();

    document.addEventListener('mouseover', (e) => {
      const t = e.target.closest('[data-cursor]');
      const link = e.target.closest('a, button, input, textarea');
      if (t) {
        const mode = t.dataset.cursor;
        cur.classList.add('is-hover');
        cur.classList.toggle('is-text', mode === 'text');
        label.textContent = t.dataset.cursorLabel || '';
      } else if (link && link.tagName !== 'INPUT' && link.tagName !== 'TEXTAREA') {
        cur.classList.add('is-hover');
        cur.classList.remove('is-text');
        label.textContent = '';
      }
    });
    document.addEventListener('mouseout', (e) => {
      if (!e.relatedTarget) return;
      if (!e.relatedTarget.closest('[data-cursor], a, button')) {
        cur.classList.remove('is-hover', 'is-text');
        label.textContent = '';
      }
    });
    document.addEventListener('mouseleave', () => cur.classList.remove('is-ready'));
    document.addEventListener('mouseenter', () => cur.classList.add('is-ready'));
  }

  /* â”€â”€â”€ Magnetic buttons â”€â”€â”€ */
  if (!isCoarse && !prefersReduced) {
    document.querySelectorAll('[data-magnetic]').forEach((el) => {
      const strength = parseFloat(el.dataset.magnetic) || 0.3;
      el.addEventListener('mousemove', (e) => {
        const r = el.getBoundingClientRect();
        const x = (e.clientX - r.left - r.width / 2) * strength;
        const y = (e.clientY - r.top - r.height / 2) * strength;
        el.style.transform = `translate(${x}px, ${y}px)`;
      });
      el.addEventListener('mouseleave', () => {
        el.style.transform = '';
      });
    });
  }

  /* â”€â”€â”€ Number counter â”€â”€â”€ */
  const countIO = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting || entry.target.dataset.counted) return;
      entry.target.dataset.counted = '1';
      const el = entry.target;
      const target = parseInt(el.dataset.count, 10);
      if (target === 0) { el.textContent = '0'; return; }
      const duration = 1400;
      const start = performance.now();
      const ease = (t) => 1 - Math.pow(1 - t, 3);
      const tick = (now) => {
        const t = Math.min((now - start) / duration, 1);
        el.textContent = Math.round(target * ease(t));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('[data-count]').forEach((el) => countIO.observe(el));

  /* â”€â”€â”€ Scroll progress fallback â”€â”€â”€ */
  if (!CSS.supports('animation-timeline: scroll()')) {
    const bar = document.querySelector('.scroll-progress');
    if (bar) {
      const upd = () => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        const pct = max > 0 ? doc.scrollTop / max : 0;
        bar.style.transform = `scaleX(${pct})`;
      };
      window.addEventListener('scroll', upd, { passive: true });
      window.addEventListener('resize', upd, { passive: true });
      upd();
    }
  }

  /* â”€â”€â”€ Live Bengaluru clock â”€â”€â”€ */
  const clocks = document.querySelectorAll('[data-clock]');
  if (clocks.length) {
    const fmt = new Intl.DateTimeFormat('en-IN', {
      timeZone: 'Asia/Kolkata',
      hour: '2-digit', minute: '2-digit', second: '2-digit',
      hour12: false
    });
    const tick = () => {
      const t = fmt.format(new Date()) + ' IST';
      clocks.forEach(c => c.textContent = t);
    };
    tick();
    setInterval(tick, 1000);
  }

  /* â”€â”€â”€ Command Palette â”€â”€â”€ */
  const palette = document.getElementById('palette');
  if (palette) {
    const input = palette.querySelector('.palette__input');
    const list = palette.querySelector('.palette__list');
    const items = [
      { name: 'Home',         sub: 'Landing',           icon: 'H',  href: 'index.html' },
      { name: 'Work',         sub: 'Selected projects', icon: 'W',  href: 'work.html' },
      { name: 'About',        sub: 'The person',        icon: 'A',  href: 'about.html' },
      { name: 'Contact',      sub: 'Get in touch',      icon: 'C',  href: 'contact.html' },
      { name: 'DriveU Design System',   sub: 'Case study', icon: '1', href: 'case-driveu-brand-system.html' },
      { name: 'SprintMart Shared Cart', sub: 'Case study', icon: '2', href: 'case-sprintmart.html' },
      { name: 'UYARA User Research',    sub: 'Case study', icon: '3', href: 'case-uyara-research.html' },
      { name: 'Download RÃ©sumÃ©', sub: 'PDF',              icon: 'â†“',  href: 'assets/docs/Santhosh-Kumar-M-Resume.pdf' },
      { name: 'Toggle theme', sub: 'Dark / Light',      icon: 'âŒ˜',  action: 'theme' },
      { name: 'Email me',     sub: 'contact@designbysanthosh.in', icon: '@', href: 'mailto:contact@designbysanthosh.in' },
      { name: 'LinkedIn',     sub: 'in/santhosh-ui-d3s1gn3r', icon: 'in', href: 'https://linkedin.com/in/santhosh-ui-d3s1gn3r' },
      { name: 'Behance',      sub: 'behance.net/designbysan', icon: 'BÄ“', href: 'https://www.behance.net/designbysan' },
    ];
    let active = 0;

    const render = (q = '') => {
      const filtered = items.filter(i =>
        (i.name + ' ' + i.sub).toLowerCase().includes(q.toLowerCase())
      );
      list.innerHTML = filtered.map((i, idx) => `
        <div class="palette__item ${idx === active ? 'is-active' : ''}" data-idx="${idx}">
          <span class="palette__icon">${i.icon}</span>
          <div>
            <div class="palette__name">${i.name}</div>
            <div class="palette__sub">${i.sub}</div>
          </div>
          <span class="palette__sub">â†µ</span>
        </div>
      `).join('');
      list.querySelectorAll('.palette__item').forEach((el) => {
        el.addEventListener('click', () => fire(filtered[+el.dataset.idx]));
        el.addEventListener('mouseenter', () => {
          active = +el.dataset.idx;
          list.querySelectorAll('.palette__item').forEach(x => x.classList.remove('is-active'));
          el.classList.add('is-active');
        });
      });
      return filtered;
    };

    const fire = (item) => {
      if (!item) return;
      if (item.action === 'theme') { window.toggleTheme(); close(); return; }
      if (item.href) {
        if (item.href.startsWith('http') || item.href.startsWith('mailto')) {
          window.open(item.href, '_blank');
        } else {
          window.location.href = item.href;
        }
      }
      close();
    };

    const open = () => {
      palette.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      active = 0;
      input.value = '';
      render();
      setTimeout(() => input.focus(), 30);
    };
    const close = () => {
      palette.classList.remove('is-open');
      document.body.style.overflow = '';
    };

    window.openPalette = open;

    palette.addEventListener('click', (e) => {
      if (e.target === palette) close();
    });
    input.addEventListener('input', () => { active = 0; render(input.value); });
    input.addEventListener('keydown', (e) => {
      const filtered = render(input.value);
      if (e.key === 'ArrowDown') { e.preventDefault(); active = (active + 1) % filtered.length; render(input.value); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); active = (active - 1 + filtered.length) % filtered.length; render(input.value); }
      else if (e.key === 'Enter') { e.preventDefault(); fire(filtered[active]); }
      else if (e.key === 'Escape') { close(); }
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        palette.classList.contains('is-open') ? close() : open();
      } else if (e.key === '/' && !['INPUT','TEXTAREA'].includes(document.activeElement.tagName)) {
        e.preventDefault();
        open();
      }
    });
  }

  /* â”€â”€â”€ Tilt cards â”€â”€â”€ */
  if (!isCoarse && !prefersReduced) {
    document.querySelectorAll('[data-tilt]').forEach((el) => {
      const max = parseFloat(el.dataset.tilt) || 6;
      el.addEventListener('mousemove', (e) => {
        const r = el.getBoundingClientRect();
        const cx = (e.clientX - r.left) / r.width - 0.5;
        const cy = (e.clientY - r.top) / r.height - 0.5;
        el.style.transform = `perspective(900px) rotateY(${cx * max}deg) rotateX(${-cy * max}deg)`;
      });
      el.addEventListener('mouseleave', () => { el.style.transform = ''; });
    });
  }

  /* â”€â”€â”€ Konami / easter egg â”€â”€â”€ */
  let buf = '';
  document.addEventListener('keydown', (e) => {
    if (['INPUT','TEXTAREA'].includes(document.activeElement.tagName)) return;
    buf = (buf + e.key.toLowerCase()).slice(-8);
    if (buf.endsWith('design')) {
      document.body.animate(
        [{ filter: 'hue-rotate(0deg)' }, { filter: 'hue-rotate(360deg)' }],
        { duration: 1400, easing: 'ease-in-out' }
      );
    }
  });

  /* â”€â”€â”€ Dynamic availability date â”€â”€â”€ */
  document.querySelectorAll('[data-avail-date]').forEach(el => {
    const now = new Date();
    el.textContent = now.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
  });

  /* â”€â”€â”€ Page veil: exit wipe on internal navigation (edit-like cut) â”€â”€â”€ */
  if (!prefersReduced) {
    const veil = document.createElement('div');
    veil.className = 'veil';
    veil.setAttribute('aria-hidden', 'true');
    document.body.appendChild(veil);

    document.addEventListener('click', (e) => {
      const a = e.target.closest('a[href]');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      if (a.target === '_blank' || a.hasAttribute('download')) return;
      const href = a.getAttribute('href');
      if (!href || href.startsWith('#') || href.startsWith('mailto:') ||
          href.startsWith('tel:') || href.startsWith('http')) return;
      e.preventDefault();
      veil.classList.add('is-active');
      setTimeout(() => { window.location.href = href; }, 300);
    });

    /* bfcache return: never leave the veil down */
    window.addEventListener('pageshow', () => veil.classList.remove('is-active'));
  }
})();_application/javascriptOvbplist00Ô
