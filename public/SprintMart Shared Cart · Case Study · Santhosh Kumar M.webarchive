<script>
  /* Flow board: hover a step, preview its screen */
  (function () {
    const stage = document.getElementById('flowScreen');
    const label = document.getElementById('flowLabel');
    const steps = document.querySelectorAll('#flowBoard .step[data-screen]');
    if (!stage || !steps.length) return;
    steps.forEach((s) => { new Image().src = s.dataset.screen; });
    const idle = { src: stage.getAttribute('src'), html: label.innerHTML };
    let current = null;
    function show(step) {
      if (current === step) return;
      current = step;
      steps.forEach((s) => s.classList.toggle('is-previewing', s === step));
      stage.closest('.flow-stage').classList.toggle('is-live', !!step);
      const src = step ? step.dataset.screen : idle.src;
      if (stage.getAttribute('src') !== src) {
        stage.style.opacity = '0';
        stage.style.transform = 'scale(0.985)';
        setTimeout(() => {
          stage.src = src;
          stage.style.opacity = '1';
          stage.style.transform = 'scale(1)';
        }, 110);
      }
      label.innerHTML = step
        ? '<b>' + step.dataset.label + '</b><br>' + step.querySelector('.t').textContent
        : idle.html;
    }
    steps.forEach((s) => {
      s.addEventListener('mouseenter', () => show(s));
      s.addEventListener('focus', () => show(s));
      s.addEventListener('click', () => show(s));
    });
    document.getElementById('flowBoard').addEventListener('mouseleave', () => show(null));
  })();

</script>



