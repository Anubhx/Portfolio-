<style>
  /* â•â•â•â•â•â•â•â•â•â•â• HERO â•â•â•â•â•â•â•â•â•â•â• */
  .case-hero {
    padding-top: 140px;
    padding-bottom: 64px;
    border-bottom: 1px solid var(--hairline);
  }
  .case-hero__crumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mist);
    margin-bottom: 44px;
  }
  .case-hero__crumb a { color: var(--mist); transition: color var(--t-1) var(--ease); }
  .case-hero__crumb a:hover { color: var(--paper); }
  .case-hero__crumb .sep { color: var(--graphite); }
  .case-hero h1 {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(48px, 7.6vw, 124px);
    line-height: 0.98;
    letter-spacing: -0.04em;
    color: var(--paper);
    margin-bottom: 36px;
  }
  .case-hero h1 em {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }
  .case-meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    padding: 26px 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .case-meta__cell {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 28px;
    border-left: 1px solid var(--hairline);
  }
  .case-meta__cell:first-child { padding-left: 0; border-left: none; }
  .case-meta__cell:last-child { padding-right: 0; }
  .case-meta__k {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mist);
  }
  .case-meta__v {
    font-family: var(--display);
    font-weight: 500;
    font-size: 15px;
    color: var(--paper);
    line-height: 1.4;
    min-height: 2.8em;
  }
  .tldr {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px;
    align-items: start;
    margin-top: 24px;
    padding: 22px 26px;
    border: 1px solid var(--hairline);
    border-left: 2px solid var(--accent);
    border-radius: 0 8px 8px 0;
    background: var(--bone);
  }
  .tldr__k {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    padding-top: 4px;
    white-space: nowrap;
  }
  .tldr__v { font-size: 15.5px; line-height: 1.7; color: var(--paper-dim); max-width: 90ch; }
  .tldr__v b { color: var(--paper); font-weight: 500; }

  /* Hero: the Shared Cart scene: fanned phones, ghost mark, live pills */
  .trio {
    position: relative;
    margin-top: 64px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(8px, 1.5vw, 24px);
    padding-top: clamp(48px, 6vw, 88px);
  }
  .trio::before {
    content: '';
    position: absolute;
    left: 50%; bottom: 0;
    transform: translateX(-50%);
    width: min(820px, 84%);
    height: 58%;
    background: radial-gradient(ellipse 50% 55% at 50% 100%, rgba(212,146,26,0.11) 0%, rgba(212,146,26,0.04) 40%, transparent 64%);
    filter: blur(2px);
    pointer-events: none;
  }
  .trio__mark {
    position: absolute;
    top: 0; left: 0; right: 0;
    text-align: center;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(56px, 8.5vw, 132px);
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: rgba(240,237,229,0.055);
    user-select: none;
    pointer-events: none;
    transition: color 500ms var(--ease);
  }
  .trio:hover .trio__mark { color: rgba(255,69,0,0.10); }
  .trio .device {
    position: relative;
    transition: transform 650ms var(--spring), box-shadow 650ms var(--ease);
  }
  .trio .device--mid {
    width: clamp(250px, 20vw, 320px);
    z-index: 3;
  }
  .trio .device--l {
    width: clamp(190px, 15vw, 240px);
    transform: translateY(34px) rotate(-7deg);
    margin-right: clamp(-40px, -2.5vw, -24px);
    z-index: 1;
  }
  .trio .device--r {
    width: clamp(190px, 15vw, 240px);
    transform: translateY(38px) rotate(7deg);
    margin-left: clamp(-40px, -2.5vw, -24px);
    z-index: 2;
  }
  .trio:hover .device--mid { transform: translateY(-10px); box-shadow: 0 36px 90px -32px rgba(0,0,0,0.75); }
  .trio:hover .device--l   { transform: translate(-12px, 26px) rotate(-9.5deg); }
  .trio:hover .device--r   { transform: translate(12px, 30px) rotate(9.5deg); }
  .trio__pill {
    position: absolute;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    font-weight: 500;
    padding: 9px 15px;
    border-radius: 999px;
    box-shadow: 0 16px 40px rgba(0,0,0,0.45);
    transition: transform 650ms var(--spring);
    pointer-events: none;
  }
  .trio__pill--live {
    top: 34%; left: clamp(2%, 12vw, 16%);
    background: #FFFFFF;
    color: #1E1B30;
    transform: rotate(-5deg);
  }
  .trio__pill--live::before {
    content: '';
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #D4921A;
  }
  .trio__pill--split {
    top: 26%; right: clamp(2%, 12vw, 16%);
    background: #1E1B30;
    color: #F1EFE9;
    transform: rotate(5deg);
  }
  .trio:hover .trio__pill--live  { transform: rotate(-6deg) translate(-4px, -8px); }
  .trio:hover .trio__pill--split { transform: rotate(6deg) translate(4px, -8px); }
  .trio-cap {
    margin-top: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mist);
    text-align: center;
  }
  .trio-cap::before,
  .trio-cap::after {
    content: '';
    width: clamp(32px, 6vw, 96px);
    height: 1px;
    background: var(--hairline);
  }
  .trio-cap b { color: var(--paper-dim); font-weight: 500; }
  @media (max-width: 720px) {
    .trio { gap: 14px; padding-top: 40px; }
    .trio .device--l, .trio .device--r { display: none; }
    .trio .device--mid { width: min(270px, 72vw); }
    .trio__pill { display: none; }
    .trio__mark { font-size: 44px; }
  }

  /* â•â•â•â•â•â•â•â•â•â•â• SECTION ANATOMY â•â•â•â•â•â•â•â•â•â•â• */
  .case-section {
    padding-top: 64px;
    padding-bottom: 64px;
    border-bottom: 1px solid var(--hairline);
  }
  .case-section__grid {
    display: grid;
    grid-template-columns: 0.7fr 1.5fr;
    gap: 64px;
    align-items: start;
  }
  .case-section__head { position: sticky; top: 96px; }
  .case-section__head .eyebrow { margin-bottom: 14px; }
  .case-section__head h2,
  .case-section__stackhead h2 {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(28px, 3.2vw, 42px);
    line-height: 1.08;
    letter-spacing: -0.022em;
    color: var(--paper);
  }
  .case-section__head h2 em,
  .case-section__stackhead h2 em {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }
  .case-section__head .def,
  .case-section__stackhead .def {
    margin-top: 18px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--paper-dim);
    max-width: 44ch;
  }
  .case-section__head .def b,
  .case-section__stackhead .def b { color: var(--paper); font-weight: 500; }
  .case-section__stackhead { max-width: 860px; margin-bottom: 36px; }
  .case-section__stackhead .def { max-width: 66ch; }
  .case-section__body { display: flex; flex-direction: column; gap: 22px; }
  .case-section__body p {
    font-size: 16px;
    line-height: 1.75;
    color: var(--paper-dim);
    max-width: 64ch;
  }
  .case-section__body p b { color: var(--paper); font-weight: 500; }
  .pull {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 1.32;
    letter-spacing: -0.016em;
    color: var(--paper);
    padding: 18px 0 18px 24px;
    border-left: 2px solid var(--accent);
    max-width: 56ch;
  }
  .pull em {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }
  .pull cite {
    display: block;
    margin-top: 10px;
    font-family: var(--mono);
    font-style: normal;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mist);
  }

  /* Device */
  .device {
    background: var(--bone);
    border: 1px solid var(--line);
    border-radius: 26px;
    padding: 9px;
    position: relative;
    box-shadow: 0 24px 64px -32px rgba(0,0,0,0.55);
  }
  .device::before {
    content: '';
    position: absolute;
    top: 16px; left: 50%;
    transform: translateX(-50%);
    width: 56px; height: 13px;
    border-radius: 8px;
    background: var(--ink);
    border: 1px solid var(--hairline);
    z-index: 2;
  }
  .device img {
    border-radius: 18px;
    border: 1px solid var(--hairline);
    width: 100%;
  }

  /* Research: insight rows */
  .ins-stack {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: 8px;
    overflow: hidden;
  }
  .ins-row {
    background: var(--bone);
    padding: 20px 24px;
    display: grid;
    grid-template-columns: 96px 110px 1fr;
    gap: 24px;
    align-items: baseline;
    transition: background 180ms var(--ease);
  }
  .ins-row:hover { background: var(--surface); }
  .ins-row__tag {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .ins-row__stat {
    font-family: var(--display);
    font-weight: 600;
    font-size: 30px;
    letter-spacing: -0.02em;
    color: var(--paper);
    white-space: nowrap;
  }
  .ins-row__stat span { color: var(--accent); font-size: 0.6em; }
  .ins-row__text { font-size: 14px; line-height: 1.65; color: var(--paper-dim); }
  .ins-row__text b { color: var(--paper); font-weight: 500; }
  .ins-row__text .so { color: var(--mist); }
  .ins-row__text .so::before {
    content: 'so â†’';
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 6px 0 2px;
  }

  /* â•â•â•â•â•â•â•â•â•â•â• THE FLOW: hover a step, see the screen â•â•â•â•â•â•â•â•â•â•â• */
  .flow-hint {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 22px;
  }
  .flow-hint::before { content: 'â–£'; font-size: 12px; }
  .flow-panel {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 6px;
    padding: clamp(28px, 3.5vw, 56px);
    overflow: hidden;
  }
  .flow-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--hairline) 1px, transparent 1px),
      linear-gradient(90deg, var(--hairline) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.35;
    pointer-events: none;
  }
  .flow-board {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) auto minmax(0, 1fr);
    grid-template-areas: "people stage sys";
    gap: 44px clamp(32px, 4vw, 64px);
    align-items: center;
  }
  .flow-people {
    grid-area: people;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  .lane--sys { grid-area: sys; align-self: center; }
  .lane--sys .lane__head.sys { color: var(--accent); }
  .lane { position: relative; padding-left: 20px; }
  .lane::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 44px;
    bottom: 22px;
    width: 1px;
    background: var(--hairline);
  }
  .lane__head {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
    padding-bottom: 12px;
    margin-bottom: 14px;
    border-bottom: 1px solid var(--hairline);
  }
  .lane__head span { color: var(--mist); text-transform: none; letter-spacing: 0.04em; }
  .lane__head.sys { color: var(--accent); }
  .lane .step {
    position: relative;
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 10px;
    align-items: baseline;
    padding: 11px 12px;
    border: 1px solid var(--hairline);
    border-radius: 6px;
    background: var(--bone);
    font-size: 13px;
    line-height: 1.55;
    color: var(--paper-dim);
    margin-bottom: 10px;
    transition: border-color var(--t-1) var(--ease), background var(--t-1) var(--ease),
                color var(--t-1) var(--ease), transform 280ms var(--spring);
  }
  .lane .step::before {
    content: '';
    position: absolute;
    left: -19.5px;
    top: 50%;
    transform: translateY(-50%);
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--graphite);
    border: 2px solid var(--ink);
    transition: background var(--t-1) var(--ease);
  }
  .lane .step--decision::before { border-radius: 2px; transform: translateY(-50%) rotate(45deg); }
  .lane .step[data-screen] { cursor: pointer; }
  .lane .step[data-screen]:hover,
  .lane .step.is-previewing {
    border-color: var(--accent);
    background: var(--surface);
    color: var(--paper);
    transform: translateX(4px);
  }
  .lane--sys .step[data-screen]:hover,
  .lane--sys .step.is-previewing { transform: translateY(-2px); }
  .lane .step[data-screen]:hover::before,
  .lane .step.is-previewing::before { background: var(--accent); }
  .lane .step .n {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--mist);
    letter-spacing: 0.06em;
  }
  .lane .step--decision { border-style: dashed; border-color: var(--line); }
  .lane .step--terminal { background: var(--surface); }
  .lane__end {
    margin-top: 2px;
    padding-left: 12px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.05em;
    color: var(--graphite);
  }
  .flow-stage {
    grid-area: stage;
    /* full frame always visible: width follows viewport height, never viewport-cropped */
    width: clamp(280px, min(24vw, calc((100vh - 250px) * 0.44)), 348px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .flow-stage .device {
    width: 100%;
    transition: border-color var(--t-1) var(--ease), box-shadow var(--t-1) var(--ease),
                transform 500ms var(--spring);
  }
  .flow-stage.is-live .device {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), 0 28px 72px -24px rgba(255,69,0,0.28);
    transform: translateY(-5px);
  }
  .flow-stage .device img {
    transition: opacity 180ms var(--ease), transform 220ms var(--ease);
  }
  .flow-stage__label {
    flex: 0 0 auto;
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mist);
    text-align: center;
    line-height: 1.6;
    min-height: 2.6em;
  }
  .flow-stage__label b { color: var(--accent); font-weight: 500; }
  @media (max-width: 1100px) {
    .flow-panel { padding: clamp(20px, 3vw, 32px); }
    .flow-board { grid-template-columns: 1fr 1fr; grid-template-areas: "people sys"; align-items: start; }
    .flow-stage { display: none; }
  }
  @media (max-width: 720px) {
    .flow-board { grid-template-columns: 1fr; grid-template-areas: "people" "sys"; }
  }

  /* â•â•â•â•â•â•â•â•â•â•â• DECISIONS: contained cards â•â•â•â•â•â•â•â•â•â•â• */
  .states {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .state-card {
    border: 1px solid var(--hairline);
    border-radius: 8px;
    background: var(--bone);
    padding: 20px 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 13px;
    transition: border-color var(--t-2) var(--ease), transform 400ms var(--spring);
  }
  .state-card:hover { border-color: var(--line); transform: translateY(-4px); }
  .state-card__well .device { transition: transform 600ms var(--spring); }
  .state-card:hover .state-card__well .device { transform: scale(1.025); }
  .state-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .state-card__step {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .state-card__chip {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .state-card__cap { font-size: 13.5px; line-height: 1.6; color: var(--paper-dim); }
  .state-card__cap b { color: var(--paper); font-weight: 500; }
  .state-card__well {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 6px;
    padding: 22px 0;
    display: flex;
    justify-content: center;
    overflow: hidden;
    margin-top: auto;
  }
  .state-card__well::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--hairline) 1px, transparent 1px),
      linear-gradient(90deg, var(--hairline) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.4;
  }
  .state-card__well .device { width: clamp(180px, 13vw, 210px); z-index: 1; }
  @media (max-width: 720px) { .states { grid-template-columns: 1fr; } }

  /* Outcome blocks */
  .callout {
    border: 1px solid var(--hairline);
    border-left: 2px solid var(--accent);
    border-radius: 0 8px 8px 0;
    background: var(--bone);
    padding: 20px 24px;
  }
  .callout .mono { display: block; margin-bottom: 8px; color: var(--accent); }
  .callout p { font-size: 15px !important; line-height: 1.7; }
  .callout a { color: var(--paper); border-bottom: 1px solid var(--accent); transition: color var(--t-1) var(--ease); }
  .callout a:hover { color: var(--accent); }
  .takeaways {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: 8px;
    overflow: hidden;
  }
  .takeaway {
    background: var(--bone);
    padding: 16px 22px;
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 18px;
    align-items: start;
  }
  .takeaway__n {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 0.08em;
    padding-top: 2px;
  }
  .takeaway__text { font-size: 14.5px; line-height: 1.65; color: var(--paper-dim); }
  .takeaway__text b { color: var(--paper); font-weight: 500; }
  .credit-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: 8px;
    overflow: hidden;
  }
  .credit-grid > div { background: var(--bone); padding: 20px 24px; }
  .credit-grid .mono { display: block; margin-bottom: 8px; }
  .credit-grid .val { font-size: 14px; line-height: 1.6; color: var(--paper-dim); }

  /* Next case */
  .next-case {
    padding-top: 110px;
    padding-bottom: 110px;
    background: var(--ink);
    border-bottom: 1px solid var(--hairline);
    text-align: center;
  }
  .next-case__eyebrow { display: inline-flex; margin-bottom: 20px; }
  .next-case h2 {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(40px, 7vw, 100px);
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--paper);
    margin-bottom: 16px;
  }
  .next-case h2 em {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }
  .next-case .mono { display: block; margin-bottom: 32px; }
  .next-case__ctas { display: flex; flex-wrap: wrap; gap: 16px; justify-content: center; align-items: center; }
  .btn--ghost {
    background: transparent;
    color: var(--paper);
    border: 1px solid var(--hairline);
    transition: border-color var(--t-1) var(--ease), color var(--t-1) var(--ease);
  }
  .btn--ghost:hover { border-color: var(--accent); color: var(--accent); }

  /* â•â•â•â•â•â•â•â•â•â•â• INTERACTION LANGUAGE: every section answers the cursor â•â•â•â•â•â•â•â•â•â•â• */
  /* Insight rows: slide + stat ignites */
  .ins-row { transition: background 200ms var(--ease), transform 300ms var(--spring); cursor: default; }
  .ins-row:hover { transform: translateX(5px); }
  .ins-row__stat { transition: color 250ms var(--ease); }
  .ins-row:hover .ins-row__stat { color: var(--accent); }

  /* Pull quotes: the accent bar grows into the words */
  .pull { transition: border-color 250ms var(--ease), padding-left 350ms var(--spring); }
  .pull:hover { padding-left: 32px; }

  /* Decision cards: the well warms like the hero */
  .state-card__well::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 50% at 50% 100%, rgba(212,146,26,0.16) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 450ms var(--ease);
    pointer-events: none;
  }
  .state-card:hover .state-card__well::after { opacity: 1; }
  .state-card__chip { transition: border-color 250ms var(--ease), color 250ms var(--ease); }
  .state-card:hover .state-card__chip { border-color: var(--accent); color: var(--accent); }

  /* Outcome: measure chips + takeaway rows */
  .measure-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .measure-chip {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper-dim);
    padding: 8px 14px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--bone);
    transition: border-color 250ms var(--ease), color 250ms var(--ease), transform 300ms var(--spring);
  }
  .measure-chip:hover { border-color: var(--accent); color: var(--paper); transform: translateY(-2px); }
  .takeaway { transition: background 200ms var(--ease), transform 300ms var(--spring); }
  .takeaway:hover { background: var(--surface); transform: translateX(5px); }

  /* Credit cells */
  .credit-grid > div { transition: background 200ms var(--ease); }
  .credit-grid > div:hover { background: var(--surface); }
  .credit-grid .mono { transition: color 250ms var(--ease); }
  .credit-grid > div:hover .mono { color: var(--accent); }

  /* TL;DR: breathes on hover */
  .tldr { transition: border-color 300ms var(--ease); }
  .tldr:hover { border-left-color: var(--accent); border-color: var(--line); }

  /* Motion: opacity only, quick */
  main .reveal,
  main .reveal-stagger > * { transform: none; transition-duration: 240ms; }
  main .d-1 { transition-delay: 40ms; }
  main .d-2 { transition-delay: 80ms; }
  main .d-3 { transition-delay: 120ms; }

  /* Responsive */
  @media (max-width: 1024px) {
    .case-section__grid { grid-template-columns: 1fr; gap: 32px; }
    .case-section__head { position: static; }
    .case-section__head .def { max-width: 64ch; }
    .case-meta { grid-template-columns: repeat(2, 1fr); gap: 24px 0; }
    .case-meta__cell { border-left: none; padding: 0; }
    .case-meta__cell:nth-child(even) { border-left: 1px solid var(--hairline); padding-left: 24px; }
    .case-meta__cell:nth-child(n+3) { border-top: 1px solid var(--hairline); padding-top: 16px; }
    .ins-row { grid-template-columns: 88px 1fr; }
    .ins-row__text { grid-column: 1 / -1; }
  }
  @media (max-width: 720px) {
    .case-hero { padding-top: 110px; padding-bottom: 44px; }
    .case-meta { grid-template-columns: 1fr; gap: 16px; }
    .case-meta__cell { border-left: none !important; padding: 0 !important; }
    .case-meta__cell:not(:first-child) { border-top: 1px solid var(--hairline); padding-top: 14px !important; }
    .tldr { grid-template-columns: 1fr; gap: 10px; }
    .credit-grid { grid-template-columns: 1fr; }
    .next-case__ctas { flex-direction: column; width: 100%; }
    .next-case__ctas .btn { width: 100%; justify-content: center; }
  }
</style>
<script defer="" data-domain="designbysanthosh.in" src="https://plausible.io/js/script.js"></script>
</head>
